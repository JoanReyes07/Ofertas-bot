# Copia este archivo como .env y llénalo. NUNCA lo subas a GitHub.

# Mercado Libre Developers (developers.mercadolibre.com.mx -> Crear aplicación)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Facebook: ID de tu Página y token de acceso de Página
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Opcional: Claude redacta los textos. Sin clave se usan plantillas.
ANTHROPIC_API_KEY=

# Tu web (para el "enlace en bio" de TikTok), p. ej. https://TUUSUARIO.github.io/ofertas-bot
WEB_URL=
SITE_NAME=Ofertas del Día México

# Categorías de las que se toman los más vendidos (IDs separados por comas).
# Lista completa: https://api.mercadolibre.com/sites/MLM/categories
# Vehículos (MLM1743), Inmuebles (MLM1459) y Servicios (MLM1540) se ignoran: el programa no los permite.
CATEGORIES=MLM1574,MLM1000,MLM1575,MLM1246,MLM1071,MLM1276,MLM1132
MIN_DISCOUNT=30
# Solo los primeros N del top de más vendidos (máx. 20)
MAX_RANK=20
MIN_PRICE=80
MAX_PRICE=5000
FETCH_LIMIT=10
PUBLISH_LIMIT=5
CHANNELS=web,facebook,whatsapp,tiktok
